{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "بيانات طالب حلقة القرآن الكريم ومستوى حفظه",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "password": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "age": { "type": "number" },
        "parentName": { "type": "string", "maxLength": 150 },
        "parentPhones": { "type": "array" },
        "currentSurah": { "type": "number" },
        "currentSurahName": { "type": "string", "maxLength": 50 },
        "currentAyah": { "type": "number" },
        "dailyNewTarget": { "type": "string", "maxLength": 100 },
        "dailyReviewTarget": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "enum": ["ضعيف", "متوسط", "قوي"] },
        "aiPlan": { "type": "object" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "سجل حضور وغياب يومي لطالب الحلقة",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["حاضر", "غائب", "متأخر", "معتذر"] },
        "delayMinutes": { "type": "number" },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "date", "status"]
    },
    "StudentEvaluation": {
      "title": "StudentEvaluation",
      "description": "تقييم أداء وتسميع الطالب اليومي",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "criteriaValues": { "type": "object" },
        "totalScore": { "type": "number" },
        "recitationDetails": { "type": "object" },
        "aiFeedback": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "date"]
    },
    "EvaluationCriteria": {
      "title": "EvaluationCriteria",
      "description": "بند تقييم مخصص في الحلقة",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["score", "stars", "options"] },
        "maxScore": { "type": "number" },
        "options": { "type": "array" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "name", "type"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "إعدادات منصة حلقة القرآن الكريم",
      "type": "object",
      "properties": {
        "allowStudentRegistration": { "type": "boolean" },
        "workDaysPerWeek": { "type": "number" },
        "workDaysNames": { "type": "array" },
        "halaqahName": { "type": "string", "maxLength": 150 },
        "teacherName": { "type": "string", "maxLength": 100 }
      },
      "required": ["halaqahName", "teacherName"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "رسالة في محادثة مستشار عمران الذكي",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sender": { "type": "string", "enum": ["user", "ai"] },
        "text": { "type": "string", "maxLength": 5000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "sender", "text"]
    },
    "BehaviorViolation": {
      "title": "BehaviorViolation",
      "description": "سجل مخالفة سلوكية أو توجيه تربوي وإشعار ولي الأمر",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 30 },
        "time": { "type": "string", "maxLength": 30 },
        "violationType": { "type": "string", "maxLength": 200 },
        "severity": { "type": "string", "enum": ["تنبيه", "بسيطة", "متوسطة", "جسيمة"] },
        "description": { "type": "string", "maxLength": 2000 },
        "actionTaken": { "type": "string", "maxLength": 500 },
        "pointsDeducted": { "type": "number" },
        "status": { "type": "string", "enum": ["تم الإشعار", "قيد المتابعة", "تم التوجيه والمعالجة"] },
        "parentNotified": { "type": "boolean" },
        "parentNotificationDate": { "type": "string", "maxLength": 50 },
        "parentNotificationPhone": { "type": "string", "maxLength": 50 },
        "messageText": { "type": "string", "maxLength": 3000 },
        "teacherName": { "type": "string", "maxLength": 150 },
        "showInPortal": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "date", "violationType", "severity"]
    },
    "QuranComplex": {
      "title": "QuranComplex",
      "description": "سجل المجمع القرآني والمشرف والحلقات التابعة له",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "supervisorTeacherId": { "type": "string", "maxLength": 128 },
        "supervisorTeacherName": { "type": "string", "maxLength": 150 },
        "customFirebaseConfig": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "Halaqah": {
      "title": "Halaqah",
      "description": "سجل الحلقة القرآنية والمعلمين المنتسبين لها",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "primaryTeacherName": { "type": "string", "maxLength": 150 },
        "teacherIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "معرفات المعلمين المنتسبين للحلقة"
        },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "TeacherAccount": {
      "title": "TeacherAccount",
      "description": "بيانات حساب معلم أو مساعد معلم في الحلقات",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["معلم أساسي", "مساعد معلم", "مشرف عام", "معلم تجويد"] },
        "halaqahId": { "type": "string", "maxLength": 128 },
        "halaqahName": { "type": "string", "maxLength": 150 },
        "halaqahIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "قائمة الحلقات التي ينتمي إليها المعلم"
        },
        "isPrimary": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "username", "password"]
    },
    "Exam": {
      "title": "Exam",
      "description": "سجل اختبار أو كويز قرآني وتجويدي",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "totalPoints": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title"]
    },
    "ExamSubmission": {
      "title": "ExamSubmission",
      "description": "تسليمات وإجابات ونتائج الطلاب في الاختبارات",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "totalScoreEarned": { "type": "number" },
        "percentage": { "type": "number" },
        "submittedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "examId", "studentId"]
    },
    "SurahRecording": {
      "title": "SurahRecording",
      "description": "تسجيلات السور والتقسيم الزمني للآيات",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "surahNumber": { "type": "number" },
        "surahName": { "type": "string", "maxLength": 100 },
        "youtubeUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["processing", "ready"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "surahNumber", "surahName", "youtubeUrl"]
    },
    "StudentListeningLog": {
      "title": "StudentListeningLog",
      "description": "سجل استماع الطالب للسور والآيات ومعدل التكرار",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "surahNumber": { "type": "number" },
        "surahName": { "type": "string", "maxLength": 100 },
        "targetCount": { "type": "number" },
        "completedCount": { "type": "number" },
        "isFullyCompleted": { "type": "boolean" },
        "date": { "type": "string", "maxLength": 30 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "surahNumber", "completedCount"]
    }
  },
  "firestore": {
    "/complexes/{complexId}": {
      "schema": "QuranComplex",
      "description": "قائمة المجمعات القرآنية والمشرفين التابعين لها"
    },
    "/teachers/{teacherId}": {
      "schema": "TeacherAccount",
      "description": "حسابات وبيانات المعلمين والمشرفين"
    },
    "/halaqahs/{halaqahId}": {
      "schema": "Halaqah",
      "description": "قائمة الحلقات القرآنية في المركز"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "مجموعة طلاب الحلقة وسجلاتهم"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "سجلات الحضور والغياب اليومية"
    },
    "/evaluations/{evaluationId}": {
      "schema": "StudentEvaluation",
      "description": "سجلات التقييمات والتسميع اليومي للطلاب"
    },
    "/criteria/{criteriaId}": {
      "schema": "EvaluationCriteria",
      "description": "معايير وبنود التقييم المعتمدة للحلقة"
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "الإعدادات العامة للحلقة"
    },
    "/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "سجل رسائل مستشار عمران القرآني"
    },
    "/violations/{violationId}": {
      "schema": "BehaviorViolation",
      "description": "سجلات المخالفات السلوكية والتوجيهات التربوية"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "قائمة الاختبارات والكويزات القرآنية"
    },
    "/exam_submissions/{submissionId}": {
      "schema": "ExamSubmission",
      "description": "تسليمات ودرجات الطلاب في الاختبارات"
    },
    "/surah_recordings/{recordingId}": {
      "schema": "SurahRecording",
      "description": "تسجيلات السور وتقسيم المقاطع للاستماع"
    },
    "/listening_logs/{logId}": {
      "schema": "StudentListeningLog",
      "description": "سجلات استماع الطلاب للسور والتكرار اليومي"
    },
    "/test/{testId}": {
      "schema": {
        "$ref": "#/entities/Student"
      },
      "description": "مستند فحص اتصال قاعدة البيانات"
    }
  }
}
